# =============================================================================
#  WastedDailyVI – Geheimnisse (Secrets)
#
#  1. Kopieren:  cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#  2. Werte eintragen, ohne Leerzeichen um das "=".
#     Enthält ein Wert $ oder # oder Leerzeichen (typisch bei Passwörtern aus dem Passwort-Manager), den
#     Wert in EINFACHE Anführungszeichen setzen:   WDVI_DASHBOARD_PASSWORD='Ab$cd#x9 yz'
#     (Sonst macht Docker Compose aus "$cd" eine leere Variable und schneidet ab " #" ab – das Passwort
#     stimmt dann nicht.) Einfache Anführungszeichen im Wert selbst gehen nicht – so ein Zeichen meiden.
#  3. Diese Datei NIEMALS teilen, hochladen oder in Git committen!
#
#  Leer gelassene Einträge = nicht konfiguriert. Wie man die Werte bekommt: docs/SETUP.md
#  Nach Änderungen:  docker compose up -d   (startet den Container mit den neuen Werten neu)
# =============================================================================

# --- Claude (Pflicht bei llm.backend: "api") ---------------------------------
# API-Key von https://console.anthropic.com -> "API Keys". Beginnt mit "sk-ant-".
ANTHROPIC_API_KEY=

# --- Dashboard -----------------------------------------------------------------
# Passwort fürs Review-Dashboard (Benutzername beliebig). Im Docker-Betrieb PFLICHT.
# Lang und zufällig wählen, z. B. 4–5 zufällige Wörter. Mit $, # oder Leerzeichen: in '…' setzen (siehe oben).
WDVI_DASHBOARD_PASSWORD=

# --- Twitch (https://dev.twitch.tv/console -> "Register Your Application") ------
WDVI_TWITCH_CLIENT_ID=
WDVI_TWITCH_CLIENT_SECRET=

# --- Reddit (optional; ohne Werte wird die öffentliche Schnittstelle genutzt) --
# https://www.reddit.com/prefs/apps -> "create another app..." -> Typ "script"
WDVI_REDDIT_CLIENT_ID=
WDVI_REDDIT_CLIENT_SECRET=

# --- YouTube (Hochladen) -------------------------------------------------------
# Pfad zur heruntergeladenen OAuth-Datei aus der Google Cloud Console (relativ zum Projektordner).
# Lege die Datei nach data/client_secret.json – der Ordner data/ ist im Container eingebunden.
WDVI_GOOGLE_CLIENT_SECRETS_FILE=data/client_secret.json
# Optional: API-Key nur für YouTube-Suchanfragen (sources.youtube.search_queries)
WDVI_YOUTUBE_API_KEY=

# --- TikTok (https://developers.tiktok.com -> Manage apps) ---------------------
WDVI_TIKTOK_CLIENT_KEY=
WDVI_TIKTOK_CLIENT_SECRET=

# --- Instagram / Meta (https://developers.facebook.com -> Meine Apps) ----------
# App-ID und App-Geheimcode aus "Instagram API with Instagram Login" (Instagram-App-ID/-Geheimcode)
WDVI_META_APP_ID=
WDVI_META_APP_SECRET=

# --- Docker (werden von docker compose gelesen; statt docker-compose.yml zu bearbeiten) ----
# Linux/WSL: deine Benutzer-ID ('id -u'), damit dir data/ und claude-home/ gehören. scripts/setup.sh trägt
# sie automatisch ein. Nach einer Änderung: docker compose build && docker compose up -d
# APP_UID=1000
# Dashboard im Heimnetz erreichbar machen (Standard 127.0.0.1 = nur dieser PC). Dann unbedingt
# WDVI_DASHBOARD_PASSWORD setzen! Besser: Tailscale (docs/BETRIEB.md).
# WDVI_BIND_ADDR=0.0.0.0
# Anderer Port am PC, falls 8420 belegt ist (dann auch dashboard.public_base_url in config.yaml anpassen)
# WDVI_HOST_PORT=8421
# Ohne NVIDIA-GPU: CPU-Build von PyTorch (plus docker-compose.override.yml, siehe README "Ohne GPU")
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- Optional --------------------------------------------------------------------
# Docker-Image mit Claude-Code-CLI bauen (für llm.backend: "cli" mit Claude-Abo), dann: docker compose build
# WITH_CLAUDE_CLI=1
# Langlebiges CLI-Token statt interaktivem Login (erzeugen mit: docker compose run --rm wdvi claude setup-token)
# CLAUDE_CODE_OAUTH_TOKEN=
# Eigene https-Redirect-URIs, falls das Dashboard über https erreichbar ist (z. B. Tailscale Serve).
# Exakt so auch in der TikTok- bzw. Meta-App eintragen. Leer = https://<public_base_url>/oauth/<plattform>/callback
# Beispiel: WDVI_TIKTOK_REDIRECT_URI=https://mein-pc.tailnet-name.ts.net/oauth/tiktok/callback
WDVI_TIKTOK_REDIRECT_URI=
# Beispiel: WDVI_INSTAGRAM_REDIRECT_URI=https://mein-pc.tailnet-name.ts.net/oauth/instagram/callback
WDVI_INSTAGRAM_REDIRECT_URI=
# Cookies-Datei (Netscape-Format) für yt-dlp, falls YouTube "Sign in to confirm you're not a bot" meldet.
# Datei nach data/ legen (im Container eingebunden). Der alte Name WDVI_YTDLP_COOKIES geht weiterhin.
# Beispiel: WDVI_YTDLP_COOKIES_FILE=data/cookies.txt
WDVI_YTDLP_COOKIES_FILE=
# Mehr Details im Log: DEBUG | INFO | WARNING
# WDVI_LOG_LEVEL=INFO
